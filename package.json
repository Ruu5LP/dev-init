{
  "name": "dev-init",
  "version": "0.1.0",
  "description": "CLI tool to scaffold new projects with language, AI, and feature composition",
  "type": "module",
  "bin": {
    "dev-init": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.0.0",
    "deepmerge": "^4.3.1",
    "degit": "^2.8.4",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/deepmerge": "^2.2.0",
    "@types/degit": "^2.8.6",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "scaffold",
    "template",
    "generator",
    "dev-init"
  ],
  "license": "MIT"
}
